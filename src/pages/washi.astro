---
import "../styles/global.css";
import WashiScreen from "../components/WashiScreen.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Washi Screen — Shader Study</title>
    <meta name="robots" content="noindex" />
  </head>
  <body class="washi-body">
    <WashiScreen controls={true} lightX={0.5} lightY={0.28} glow={0.7} bloom={0.55} flicker={0.22} />
    <main class="washi-stage">
      <p class="washi-eyebrow">Material study</p>
      <p class="washi-caption">Sunset through Japanese maple — Paper Shaders washi on top. Tune light, bloom, and leaf shadows.</p>
    </main>

    <style>
      .washi-body {
        background: #1a1916;
        min-height: 100vh;
      }
      .washi-stage {
        position: relative;
        z-index: 1;
        max-width: var(--measure);
        margin-inline: auto;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 0.75rem;
        padding: 1.5rem;
        color: #2a2118;
        text-shadow: 0 1px 18px rgba(247, 235, 210, 0.65);
      }
      .washi-eyebrow {
        font-family: var(--font-sans);
        font-size: var(--label-size);
        text-transform: uppercase;
        letter-spacing: 0.14em;
        margin: 0;
        color: #6b5a44;
      }
      .washi-title {
        font-family: var(--font-serif);
        font-size: clamp(3rem, 12vw, 6rem);
        line-height: 1;
        margin: 0;
        font-weight: 600;
      }
      .washi-caption {
        font-family: var(--font-serif);
        font-size: 1.05rem;
        max-width: 30rem;
        margin: 0;
        color: #4a3c2c;
      }
    </style>
  </body>
</html>
